LIVEKIT_API_KEY=votre_api_key_livekit
LIVEKIT_API_SECRET=votre_secret_livekit
LIVEKIT_PUBLIC_URL=wss://livekit.mondomaine.com

LISTEN_ADDR=:8080

AUTH_MODE=forward

FORWARD_AUTH_HEADER=Remote-User

OIDC_ISSUER_URL=https://auth.example.com/application/o/lightkit/
OIDC_CLIENT_ID=votre_client_id
OIDC_CLIENT_SECRET=votre_client_secret
OIDC_REDIRECT_URL=https://call.example.com/auth/callback